---
import MainLayout from "./MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";

const { frontmatter } = Astro.props;
---

<MainLayout title={`${frontmatter.title} | Kassahun Aweke Arega`}>
  <div class="container">
    <Sidebar />
    <div class="content">
      <article class="section post">
        <p><a href="/writing">&larr; Back to Writing</a></p>
        <h2>{frontmatter.title}</h2>
        {frontmatter.date && <p class="post-date">{frontmatter.date}</p>}
        <slot />
      </article>
    </div>
  </div>
</MainLayout>

<style>
  .post { max-width: 760px; line-height: 1.75; }
  .post-date { opacity: 0.7; margin-top: -0.5rem; }
  .post :global(p) { margin: 0 0 1.1rem; }
  .post :global(img) { max-width: 100%; height: auto; }
</style>
