---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";

// TODO: replace with your real software/tools
const tools = [
  {
    name: "Example Tool Name",
    description: "Add a short description of what this software/tool does.",
    link: "#",
  },
];
---

<MainLayout title="Software | Kassahun Aweke Arega">
  <div class="container">
    <Sidebar />
    <div class="content">
      <section class="section">
        <h2>Software</h2>
        <div class="cards">
          {tools.map((tool) => (
            <a class="card" href={tool.link} target="_blank" rel="noopener">
              <h3>{tool.name}</h3>
              <p>{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>
