---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";

const email = "kassahun-aweke.arega@polymtl.ca";

const links = [
  { label: "Email", value: email, href: `mailto:${email}` },
  { label: "GitHub", value: "Add your GitHub profile link", href: "#" },
  { label: "Google Scholar", value: "Add your Google Scholar profile link", href: "#" },
  { label: "LinkedIn", value: "Add your LinkedIn profile link", href: "#" },
  { label: "ResearchGate", value: "Add your ResearchGate profile link", href: "#" },
];
---

<MainLayout title="Contact | Kassahun Aweke Arega">
  <div class="container">
    <Sidebar />
    <div class="content">
      <section class="section">
        <h2>Contact</h2>
        <div class="cards">
          {links.map((link) => (
            <a class="card" href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
              <h3>{link.label}</h3>
              <p>{link.value}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>
