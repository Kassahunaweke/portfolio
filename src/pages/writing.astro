---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";

// TODO: replace with your real writing/blog posts
const posts = [
  {
    title: "Example Post Title",
    description: "Add a short summary of this post.",
    link: "#",
  },
];
---

<MainLayout title="Writing | Kassahun Aweke Arega">
  <div class="container">
    <Sidebar />
    <div class="content">
      <section class="section">
        <h2>Writing</h2>
        <div class="cards">
          {posts.map((post) => (
            <a class="card" href={post.link}>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>
