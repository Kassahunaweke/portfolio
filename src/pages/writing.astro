---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";

// Every .md file in src/pages/writing/ shows up here automatically (newest first).
const files = Object.values(import.meta.glob("./writing/*.md", { eager: true })) as any[];
const posts = files
  .map((f) => ({
    title: f.frontmatter.title,
    description: f.frontmatter.description ?? "",
    date: f.frontmatter.date ?? "",
    link: f.url,
  }))
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
---

<MainLayout title="Writing | Kassahun Aweke Arega">
  <div class="container">
    <Sidebar />
    <div class="content">
      <section class="section">
        <h2>Writing</h2>
        <div class="cards">
          {posts.map((post) => (
            <a class="card" href={post.link}>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>
