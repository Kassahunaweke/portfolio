---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";

// TODO: replace with your real research projects/descriptions
const projects = [
  {
    title: "Recharge realization",
    image: "/images/hero/Recharge.png",
    description: "Add a short description of this project or study.",
  },
  {
    title: "Stochastic ln(K) field",
    image: "/images/hero/stochastic.png",
    description: "Add a short description of this project or study.",
  },
  {
    title: "DeepONet architecture",
    image: "/images/hero/Deeponet.png",
    description: "Add a short description of this project or study.",
  },
  {
    title: "Wellhead protection area",
    image: "/images/hero/protection_area.png",
    description: "Add a short description of this project or study.",
  },
];
---

<MainLayout title="Research | Kassahun Aweke Arega">
  <div class="container">
    <Sidebar />
    <div class="content">
      <section class="section">
        <h2>Research</h2>
        <div class="cards">
          {projects.map((project) => (
            <div class="card">
              <img src={project.image} alt={project.title} style="width:100%; border-radius:10px; margin-bottom:15px;" />
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>
