---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";

// TODO: replace with your real publications
const publications = [
  {
    title: "Example Publication Title",
    authors: "Arega, K.A., et al.",
    venue: "Journal Name, Year",
    link: "#",
  },
];
---

<MainLayout title="Publications | Kassahun Aweke Arega">
  <div class="container">
    <Sidebar />
    <div class="content">
      <section class="section">
        <h2>Publications</h2>
        <div class="cards">
          {publications.map((pub) => (
            <a class="card" href={pub.link} target="_blank" rel="noopener">
              <h3>{pub.title}</h3>
              <p>{pub.authors}</p>
              <p>{pub.venue}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>
