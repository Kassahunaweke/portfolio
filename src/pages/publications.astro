---
import MainLayout from "../layouts/MainLayout.astro";
import Sidebar from "../components/Sidebar.astro";

// Add new publications at the top of this list (newest first).
const publications = [
  {
    title:
      "Analysis of spatio-temporal variability of groundwater storage in Ethiopia using Gravity Recovery and Climate Experiment (GRACE) data",
    authors:
      "Arega, K.A., Birhanu, B., Ali, S., Hailu, B.T., Tariq, M.A.U.R., Adane, Z., Nedaw, D.",
    venue: "Environmental Earth Sciences 83, 206 (2024)",
    link: "https://doi.org/10.1007/s12665-024-11508-2",
  },
];
---

<MainLayout title="Publications | Kassahun Aweke Arega">
  <div class="container">
    <Sidebar />
    <div class="content">
      <section class="section">
        <h2>Publications</h2>
        <div class="cards">
          {publications.map((pub) => (
            <a class="card" href={pub.link} target="_blank" rel="noopener">
              <h3>{pub.title}</h3>
              <p>{pub.authors}</p>
              <p>{pub.venue}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>
