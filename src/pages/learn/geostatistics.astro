---
import MainLayout from "../../layouts/MainLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import katex from "katex";
import "katex/dist/katex.min.css";
import { text } from "../../i18n/geostatistics";

// Page is rendered in English; the script swaps in Amharic if chosen.
const T = text.en;
const tex = (s: string, display = false) =>
  katex.renderToString(s, { displayMode: display, throwOnError: false });

const eq = {
  l1a: tex(String.raw`h = \sqrt{(x_1 - x_2)^2 + (y_1 - y_2)^2}`, true),
  l1b: tex(String.raw`\Delta z = \left| z_1 - z_2 \right|`, true),
  l2: tex(
    String.raw`\gamma(h) = \frac{1}{2\,N(h)} \sum_{i=1}^{N(h)} \big[\, z(\mathbf{x}_i) - z(\mathbf{x}_i + h) \,\big]^2`,
    true,
  ),
  spherical: tex(
    String.raw`\gamma(h) = \begin{cases} c_0 + (s - c_0)\left[\dfrac{3h}{2a} - \dfrac{h^3}{2a^3}\right] & h \le a \\[6pt] s & h > a \end{cases}`,
    true,
  ),
  exponential: tex(
    String.raw`\gamma(h) = c_0 + (s - c_0)\left[\,1 - e^{-3h/a}\,\right]`,
    true,
  ),
  gaussian: tex(
    String.raw`\gamma(h) = c_0 + (s - c_0)\left[\,1 - e^{-3h^2/a^2}\,\right]`,
    true,
  ),
};

const eq2 = {
  l4a: tex(
    String.raw`\hat z(\mathbf{x}_0) = \sum_{i=1}^{n} \lambda_i \, z(\mathbf{x}_i), \qquad \sum_{i=1}^{n} \lambda_i = 1`,
    true,
  ),
  l4b: tex(
    String.raw`\sum_{j=1}^{n} \lambda_j \, \gamma(\mathbf{x}_i - \mathbf{x}_j) + \mu = \gamma(\mathbf{x}_i - \mathbf{x}_0), \quad i = 1, \dots, n`,
    true,
  ),
  l4c: tex(
    String.raw`\sigma_K^2(\mathbf{x}_0) = \sum_{i=1}^{n} \lambda_i \, \gamma(\mathbf{x}_i - \mathbf{x}_0) + \mu`,
    true,
  ),
  l5a: tex(
    String.raw`z^{(\ell)}(\mathbf{x}_0) = \hat z_{SK}(\mathbf{x}_0) + \sigma_{SK}(\mathbf{x}_0)\,\varepsilon`,
    true,
  ),
  l5b: tex(String.raw`\varepsilon \sim \mathcal{N}(0, 1)`, true),
};

const sym = (s: string) => tex(s);

const lessons = [1, 2, 3, 4, 5].map((n) => ({ n, key: `l${n}Title`, title: (T as Record<string, string>)[`l${n}Title`] }));
---

<MainLayout title="Geostatistics, visually | Kassahun Aweke Arega">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Ethiopic:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="container">
    <Sidebar />
    <div class="content">
      <section class="section geo" id="geo" lang="en">
        <div class="geo-top">
          <div class="lang-switch" role="group" aria-label="Language">
            <button type="button" data-lang="en" aria-pressed="true">EN</button>
            <button type="button" data-lang="am" aria-pressed="false">አማርኛ</button>
          </div>
        </div>

        <h2 data-t="pageTitle">{T.pageTitle}</h2>
        <p class="geo-intro" data-t="intro" set:html={T.intro} />

        <div class="geo-toolbar">
          <button type="button" class="geo-btn" id="new-wells" data-t="newWells">{T.newWells}</button>
          <div class="legend">
            <span class="legend-title" data-t="legendTitle">{T.legendTitle}</span>
            <span data-t="legendShallow">{T.legendShallow}</span>
            <span class="legend-bar" aria-hidden="true"></span>
            <span data-t="legendDeep">{T.legendDeep}</span>
          </div>
        </div>

        <nav class="toc" aria-labelledby="toc-title">
          <h3 id="toc-title" data-t="navContents">{T.navContents}</h3>
          <ul>
            {lessons.map((l) => (
              <li><a href={`#lesson${l.n}`} data-t={l.key}>{l.title}</a></li>
            ))}
          </ul>
        </nav>

        <!-- LESSON 1 -->
        <article class="lesson" id="lesson1">
          <h3 data-t="l1Title">{T.l1Title}</h3>
          <p class="plain" data-t="l1Plain" set:html={T.l1Plain} />
          <p class="try"><b data-t="tryIt">{T.tryIt}</b>: <span data-t="l1Try">{T.l1Try}</span></p>
          <div class="viz">
            <div class="panel"><canvas id="l1-map" class="map-canvas"></canvas></div>
            <div class="panel">
              <canvas id="l1-plot" class="plot-canvas"></canvas>
              <p class="caption" data-t="l1Plot">{T.l1Plot}</p>
            </div>
          </div>
          <p class="readout" id="l1-readout" aria-live="polite"></p>
          <div class="math">
            <h4 data-t="mathTitle">{T.mathTitle}</h4>
            <div class="eq" set:html={eq.l1a} />
            <div class="eq" set:html={eq.l1b} />
            <p class="in-words" data-t="inWords">{T.inWords}</p>
            <dl class="symbols">
              <dt set:html={sym("h")} /><dd data-t="l1h">{T.l1h}</dd>
              <dt set:html={sym("(x, y)")} /><dd data-t="l1xy">{T.l1xy}</dd>
              <dt set:html={sym("z")} /><dd data-t="l1z">{T.l1z}</dd>
              <dt set:html={sym(String.raw`\Delta z`)} /><dd data-t="l1dz">{T.l1dz}</dd>
            </dl>
          </div>
          <nav class="lesson-nav">
            <span></span>
            <a class="nav-next" href="#lesson2"><span data-t="navNext">{T.navNext}</span>: <span data-t="l2Title">{T.l2Title}</span> →</a>
          </nav>
        </article>

        <!-- LESSON 2 -->
        <article class="lesson" id="lesson2">
          <h3 data-t="l2Title">{T.l2Title}</h3>
          <p class="plain" data-t="l2Plain" set:html={T.l2Plain} />
          <p class="try"><b data-t="tryIt">{T.tryIt}</b>: <span data-t="l2Try">{T.l2Try}</span></p>
          <div class="controls">
            <label class="slider">
              <span data-t="l2Band">{T.l2Band}</span>
              <input type="range" id="l2-band" min="0" max="11" step="1" value="2" />
            </label>
            <label class="check">
              <input type="checkbox" id="l2-cloud" />
              <span data-t="l2Cloud">{T.l2Cloud}</span>
            </label>
          </div>
          <div class="viz">
            <div class="panel"><canvas id="l2-map" class="map-canvas"></canvas></div>
            <div class="panel"><canvas id="l2-plot" class="plot-canvas"></canvas></div>
          </div>
          <p class="readout" id="l2-readout" aria-live="polite"></p>
          <p class="notice" data-t="l2Notice">{T.l2Notice}</p>
          <div class="math">
            <h4 data-t="mathTitle">{T.mathTitle}</h4>
            <div class="eq" set:html={eq.l2} />
            <p class="in-words" data-t="inWords">{T.inWords}</p>
            <dl class="symbols">
              <dt set:html={sym(String.raw`\gamma(h)`)} /><dd data-t="l2gamma">{T.l2gamma}</dd>
              <dt set:html={sym("N(h)")} /><dd data-t="l2N">{T.l2N}</dd>
              <dt set:html={sym(String.raw`\big[z(\mathbf{x}_i) - z(\mathbf{x}_i + h)\big]^2`)} /><dd data-t="l2diff">{T.l2diff}</dd>
              <dt set:html={sym(String.raw`\tfrac{1}{2}`)} /><dd data-t="l2half">{T.l2half}</dd>
            </dl>
          </div>
          <nav class="lesson-nav">
            <a class="nav-prev" href="#lesson1">← <span data-t="navPrev">{T.navPrev}</span></a>
            <a class="nav-next" href="#lesson3"><span data-t="navNext">{T.navNext}</span>: <span data-t="l3Title">{T.l3Title}</span> →</a>
          </nav>
        </article>

        <!-- LESSON 3 -->
        <article class="lesson" id="lesson3">
          <h3 data-t="l3Title">{T.l3Title}</h3>
          <p class="plain" data-t="l3Plain" set:html={T.l3Plain} />
          <p class="try"><b data-t="tryIt">{T.tryIt}</b>: <span data-t="l3Try">{T.l3Try}</span></p>
          <div class="controls">
            <div class="model-pick" role="radiogroup">
              <span data-t="l3Model">{T.l3Model}</span>
              <label><input type="radio" name="l3-model" value="spherical" checked /> <span data-t="l3Spherical">{T.l3Spherical}</span></label>
              <label><input type="radio" name="l3-model" value="exponential" /> <span data-t="l3Exponential">{T.l3Exponential}</span></label>
              <label><input type="radio" name="l3-model" value="gaussian" /> <span data-t="l3Gaussian">{T.l3Gaussian}</span></label>
            </div>
            <label class="slider">
              <span><span data-t="l3Nugget">{T.l3Nugget}</span> <span class="sym" set:html={sym("c_0")} /> = <output id="l3-nugget-v"></output></span>
              <input type="range" id="l3-nugget" min="0" max="1" step="0.001" value="0" />
            </label>
            <label class="slider">
              <span><span data-t="l3Sill">{T.l3Sill}</span> <span class="sym" set:html={sym("s")} /> = <output id="l3-sill-v"></output></span>
              <input type="range" id="l3-sill" min="0" max="1" step="0.001" value="0.5" />
            </label>
            <label class="slider">
              <span><span data-t="l3Range">{T.l3Range}</span> <span class="sym" set:html={sym("a")} /> = <output id="l3-range-v"></output></span>
              <input type="range" id="l3-range" min="0.3" max="8" step="0.05" value="3" />
            </label>
            <button type="button" class="geo-btn" id="l3-fit" data-t="l3Fit">{T.l3Fit}</button>
          </div>
          <div class="viz viz-single">
            <div class="panel"><canvas id="l3-plot" class="plot-canvas"></canvas></div>
          </div>
          <p class="readout" id="l3-readout" aria-live="polite"></p>
          <div class="math">
            <h4 data-t="mathTitle">{T.mathTitle}</h4>
            <div class="eq" data-model="spherical" set:html={eq.spherical} />
            <div class="eq" data-model="exponential" hidden set:html={eq.exponential} />
            <div class="eq" data-model="gaussian" hidden set:html={eq.gaussian} />
            <p class="in-words" data-t="inWords">{T.inWords}</p>
            <dl class="symbols">
              <dt set:html={sym("c_0")} /><dd><b data-t="l3Nugget">{T.l3Nugget}</b>: <span data-t="l3NuggetHelp">{T.l3NuggetHelp}</span></dd>
              <dt set:html={sym("s")} /><dd><b data-t="l3Sill">{T.l3Sill}</b>: <span data-t="l3SillHelp">{T.l3SillHelp}</span></dd>
              <dt set:html={sym("a")} /><dd><b data-t="l3Range">{T.l3Range}</b>: <span data-t="l3RangeHelp">{T.l3RangeHelp}</span></dd>
              <dt set:html={sym("h")} /><dd data-t="l3h">{T.l3h}</dd>
            </dl>
          </div>
          <nav class="lesson-nav">
            <a class="nav-prev" href="#lesson2">← <span data-t="navPrev">{T.navPrev}</span></a>
            <a class="nav-next" href="#lesson4"><span data-t="navNext">{T.navNext}</span>: <span data-t="l4Title">{T.l4Title}</span> →</a>
          </nav>
        </article>

        <!-- LESSON 4 -->
        <article class="lesson" id="lesson4">
          <h3 data-t="l4Title">{T.l4Title}</h3>
          <p class="plain" data-t="l4Plain" set:html={T.l4Plain} />
          <p class="try"><b data-t="tryIt">{T.tryIt}</b>: <span data-t="l4Try">{T.l4Try}</span></p>
          <p class="uses" id="l4-uses"></p>
          <div class="viz">
            <div class="panel">
              <div class="panel-head view-pick" role="radiogroup">
                <span data-t="show">{T.show}</span>
                <label><input type="radio" name="l4-view" value="kriging" checked /> <span data-t="l4Kriging">{T.l4Kriging}</span></label>
                <label><input type="radio" name="l4-view" value="idw" /> <span data-t="l4Idw">{T.l4Idw}</span></label>
                <label><input type="radio" name="l4-view" value="truth" /> <span data-t="l4Truth">{T.l4Truth}</span></label>
              </div>
              <canvas id="l4-map" class="map-canvas"></canvas>
            </div>
            <div class="panel">
              <div class="panel-head unc-legend">
                <b data-t="l4Unc">{T.l4Unc}</b>
                <span data-t="l4Low">{T.l4Low}</span>
                <span class="unc-bar" aria-hidden="true"></span>
                <span data-t="l4High">{T.l4High}</span>
              </div>
              <canvas id="l4-unc" class="map-canvas"></canvas>
            </div>
          </div>
          <p class="readout" id="l4-readout" aria-live="polite"></p>
          <p class="readout" id="l4-error"></p>
          <p class="caption" data-t="l4TruthNote">{T.l4TruthNote}</p>
          <p class="notice" data-t="l4Notice">{T.l4Notice}</p>
          <div class="math">
            <h4 data-t="mathTitle">{T.mathTitle}</h4>
            <div class="eq" set:html={eq2.l4a} />
            <div class="eq" set:html={eq2.l4b} />
            <div class="eq" set:html={eq2.l4c} />
            <p class="in-words" data-t="inWords">{T.inWords}</p>
            <dl class="symbols">
              <dt set:html={sym(String.raw`\hat z(\mathbf{x}_0)`)} /><dd data-t="l4zhat">{T.l4zhat}</dd>
              <dt set:html={sym(String.raw`\lambda_i`)} /><dd data-t="l4lambda">{T.l4lambda}</dd>
              <dt set:html={sym(String.raw`\textstyle\sum \lambda_i = 1`)} /><dd data-t="l4sum">{T.l4sum}</dd>
              <dt set:html={sym(String.raw`\gamma(\mathbf{x}_i - \mathbf{x}_j)`)} /><dd data-t="l4gamma">{T.l4gamma}</dd>
              <dt set:html={sym(String.raw`\mu`)} /><dd data-t="l4mu">{T.l4mu}</dd>
              <dt set:html={sym(String.raw`\sigma_K^2`)} /><dd data-t="l4var">{T.l4var}</dd>
            </dl>
          </div>
          <nav class="lesson-nav">
            <a class="nav-prev" href="#lesson3">← <span data-t="navPrev">{T.navPrev}</span></a>
            <a class="nav-next" href="#lesson5"><span data-t="navNext">{T.navNext}</span>: <span data-t="l5Title">{T.l5Title}</span> →</a>
          </nav>
        </article>

        <!-- LESSON 5 -->
        <article class="lesson" id="lesson5">
          <h3 data-t="l5Title">{T.l5Title}</h3>
          <p class="plain" data-t="l5Plain" set:html={T.l5Plain} />
          <p class="try"><b data-t="tryIt">{T.tryIt}</b>: <span data-t="l5Try">{T.l5Try}</span></p>
          <p class="uses" id="l5-uses"></p>
          <div class="controls">
            <button type="button" class="geo-btn" id="l5-another" data-t="l5Another">{T.l5Another}</button>
            <button type="button" class="geo-btn geo-btn-light" id="l5-more" data-t="l5More">{T.l5More}</button>
          </div>
          <div class="viz">
            <div class="panel">
              <div class="panel-head"><b id="l5-current"></b></div>
              <canvas id="l5-sim" class="map-canvas"></canvas>
            </div>
            <div class="panel">
              <div class="panel-head view-pick" role="radiogroup">
                <span data-t="show">{T.show}</span>
                <label><input type="radio" name="l5-view" value="kriging" checked /> <span data-t="l4Kriging">{T.l4Kriging}</span></label>
                <label><input type="radio" name="l5-view" value="average" /> <span data-t="l5Average">{T.l5Average}</span></label>
                <label><input type="radio" name="l5-view" value="truth" /> <span data-t="l4Truth">{T.l4Truth}</span></label>
              </div>
              <canvas id="l5-cmp" class="map-canvas"></canvas>
            </div>
          </div>
          <p class="readout" id="l5-readout" aria-live="polite"></p>
          <p class="notice" data-t="l5Notice">{T.l5Notice}</p>
          <div class="math">
            <h4 data-t="mathTitle">{T.mathTitle}</h4>
            <div class="eq" set:html={eq2.l5a} />
            <div class="eq" set:html={eq2.l5b} />
            <p class="in-words" data-t="inWords">{T.inWords}</p>
            <dl class="symbols">
              <dt set:html={sym(String.raw`z^{(\ell)}(\mathbf{x}_0)`)} /><dd data-t="l5zl">{T.l5zl}</dd>
              <dt set:html={sym(String.raw`\hat z_{SK}(\mathbf{x}_0)`)} /><dd data-t="l5zsk">{T.l5zsk}</dd>
              <dt set:html={sym(String.raw`\sigma_{SK}(\mathbf{x}_0)`)} /><dd data-t="l5sd">{T.l5sd}</dd>
              <dt set:html={sym(String.raw`\varepsilon`)} /><dd data-t="l5eps">{T.l5eps}</dd>
            </dl>
            <p class="sgs" data-t="l5Sgs" set:html={T.l5Sgs} />
          </div>
          <p class="next" data-t="l5End">{T.l5End}</p>
          <nav class="lesson-nav">
            <a class="nav-prev" href="#lesson4">← <span data-t="navPrev">{T.navPrev}</span></a>
            <a class="nav-next" href="#geo">↑ <span data-t="navContents">{T.navContents}</span></a>
          </nav>
        </article>
      </section>
    </div>
  </div>
</MainLayout>

<script>
  import "../../scripts/geostatistics.ts";
</script>

<style>
  .geo {
    max-width: 1100px;
    padding-left: 5%;
    padding-right: 5%;
  }
  .geo:lang(am),
  .geo:lang(am) button,
  .geo:lang(am) input {
    font-family: "Noto Sans Ethiopic", "Segoe UI", Arial, sans-serif;
  }
  .geo h2 {
    margin-bottom: 20px;
  }
  .geo-top {
    display: flex;
    justify-content: flex-end;
  }
  .lang-switch {
    display: inline-flex;
    border: 1px solid #c9d6e3;
    border-radius: 999px;
    overflow: hidden;
    background: white;
  }
  .lang-switch button {
    border: 0;
    background: transparent;
    padding: 6px 16px;
    font: inherit;
    font-family: "Noto Sans Ethiopic", "Segoe UI", Arial, sans-serif;
    cursor: pointer;
    color: #173753;
  }
  .lang-switch button[aria-pressed="true"] {
    background: #173753;
    color: white;
  }
  .geo-intro {
    max-width: 760px;
    margin: 0 auto 28px;
    text-align: center;
    font-size: 1.1rem;
  }
  .geo-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
  }
  .geo-btn {
    background: #173753;
    color: white;
    border: 0;
    border-radius: 8px;
    padding: 10px 20px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .geo-btn:hover {
    background: #0b5c8e;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: #444;
  }
  .legend-title {
    font-weight: 600;
    color: #173753;
  }
  .legend-bar {
    width: 140px;
    height: 12px;
    border-radius: 6px;
    background: linear-gradient(90deg, #2c7bb6, #abd9e9, #ffffbf, #fdae61, #d7191c);
  }
  .lesson {
    background: white;
    border-radius: 15px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
    padding: 32px;
    margin-bottom: 40px;
  }
  .lesson h3 {
    color: #0b5c8e;
    font-size: 1.5rem;
    margin-bottom: 12px;
  }
  .plain {
    font-size: 1.08rem;
    margin-bottom: 12px;
  }
  .try {
    background: #eef5fb;
    border-left: 4px solid #0b5c8e;
    padding: 10px 14px;
    border-radius: 6px;
    margin-bottom: 18px;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    align-items: center;
    margin-bottom: 18px;
  }
  .slider {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 200px;
    flex: 1;
  }
  .slider input {
    width: 100%;
    accent-color: #0b5c8e;
  }
  .check,
  .model-pick label {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    cursor: pointer;
  }
  .model-pick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
    width: 100%;
  }
  .model-pick > span {
    font-weight: 600;
  }
  .viz {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .viz-single {
    grid-template-columns: 1fr;
